<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The companion server is plain http on the user's own private network
	     (LAN or Tailscale, which is WireGuard-encrypted anyway); ATS would
	     otherwise block http to Tailscale IPs / *.ts.net hostnames. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.matt-nz.pimobile.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pi-companion</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
